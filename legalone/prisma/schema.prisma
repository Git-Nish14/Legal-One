generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String @unique
  password  String
}

model Lawyer {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  email          String @unique
  password       String
  license        String
  experience     String
  specialization String
}
